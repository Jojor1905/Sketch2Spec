# Local demo only. Load explicitly with uvicorn --env-file backend/.env.
AUTH_ENV=development
AUTH_DEMO_ENABLED=true
AUTH_USERNAME=admin1234
AUTH_PASSWORD_HASH=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_STORE_URL=
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
