NEXT_PUBLIC_DETECTION_API_URL=http://localhost:8000
DEMO_USERNAME=admin1234
DEMO_PASSWORD=admin1234
# Change this to a long, unique value before deploying the backend.
AUTH_SECRET=change-this-before-production
